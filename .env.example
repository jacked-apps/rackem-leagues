# App environment — controls the EnvironmentBanner and any other
# environment-aware behavior. Valid values: development | staging | production.
# If omitted, the app defaults to 'development'. Staging and production are
# set by .github/workflows/deploy-*.yml — do not commit those values here.
VITE_APP_ENV=development

# Remote Supabase (Production)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Local Supabase (Development)
VITE_SUPABASE_URL=http://localhost:54321
#VITE_SUPABASE_URL=http://YOUR_LOCAL_IP:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key

# Local Supabase Connection Details (for reference)
# API URL: http://127.0.0.1:54321
# Studio URL: http://127.0.0.1:54323
# Database URL: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Mailpit URL (email testing): http://127.0.0.1:54324
