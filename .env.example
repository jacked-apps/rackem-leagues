# App environment — controls the EnvironmentBanner and any other
# environment-aware behavior. Valid values: development | staging | production.
# If omitted, the app defaults to 'development'. Staging and production are
# set by .github/workflows/deploy-*.yml — do not commit those values here.
VITE_APP_ENV=development

# Remote Supabase (Production)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Local Supabase (Development)
VITE_SUPABASE_URL=http://localhost:54321
#VITE_SUPABASE_URL=http://YOUR_LOCAL_IP:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key

# Web Push notifications — VAPID public key (Unit 2).
# The client passes this as the applicationServerKey when subscribing a device
# to push. It is PUBLIC (safe to expose), but MUST be present at BUILD time in
# every environment — local .env here, and each CI build env for staging/prod.
# Generate a keypair per docs/ops/push-notifications-secrets.md. The PRIVATE half
# + VAPID_SUBJECT + DISPATCH_SHARED_SECRET are server secrets that live in
# supabase/functions/.env locally (and Supabase secrets in staging/prod) —
# never in this file.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Local Supabase Connection Details (for reference)
# API URL: http://127.0.0.1:54321
# Studio URL: http://127.0.0.1:54323
# Database URL: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Mailpit URL (email testing): http://127.0.0.1:54324

# =====================================================================
# E2E Test Foundation (Playwright sandbox)
# =====================================================================
# These two variables are read by:
#   - scripts/e2e-setup.mjs (the pnpm e2e:setup runner)
#   - tests/e2e/fixtures/users.ts (foundation user palette, when Unit 3 ships)
#
# Both live in .env.local (gitignored). Never commit real values here.
#
# E2E_PW: the foundation users' shared password. Distinct from
#   supabase/seed_test_users.sql's password ("test-password-123") so the
#   two test populations are not credential-equivalent. Local-only.
#   Ask the team channel for the current value, or check pinned messages.
#   The bcrypt hash committed in database/e2e_seed.sql was generated for
#   this value; if you change it, regenerate the hash (instructions in
#   the seed file's header comment).
# E2E_PW=
#
# E2E_LOCAL_OK: gate that allows database/e2e_seed.sql to run. Set to
#   exactly "true". The pnpm e2e:setup runner refuses to run without it,
#   AND the SQL file's own DO block re-asserts it as a Postgres GUC.
#   NEVER set this against any database other than your local Supabase
#   instance. The seed performs DELETE statements on rows matching the
#   "e2e-" / "E2E Test Org" patterns; running it against a non-local DB
#   could destroy real data.
# E2E_LOCAL_OK=true

# =====================================================================
# Legacy: PR #78 single-user Playwright credentials
# =====================================================================
# These are still read by the current tests/e2e/auth.setup.ts. They will
# be removed when Unit 3 (multi-user auth setup) ships and replaces the
# single-user model with the foundation-seed pattern above.
# E2E_TEST_EMAIL=test-user@example.com
# E2E_TEST_PASSWORD=your-test-password

# Optional: override the base URL Playwright targets. If unset, tests
# run against local dev (http://localhost:5173) with auto-started Vite.
# Unit 4 (when it ships) will add a startup guard that throws on any
# non-localhost target unless E2E_REMOTE_OK=true is also set.
# E2E_BASE_URL=https://staging.rackemleagues.com
