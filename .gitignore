# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables (contains secrets)
.env
.env.local
.env.*.local

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Database backups (contain sensitive auth data)
database_backups/

# Playwright — generated artifacts from test runs
playwright-report/
test-results/

# Playwright — saved auth state contains session cookies/tokens, never commit
tests/e2e/.auth/

# Per-user Claude Code settings — local-only, should not be committed.
# (Project-wide Claude config can still live under .claude/ as long as
# it's named something other than settings.local.json.)
.claude/settings.local.json
